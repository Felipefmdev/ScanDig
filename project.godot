; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ScanDig"
run/main_scene="res://world/title_screen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon/scandig_icon.svg"

[autoload]

CoreGameState="*res://core/game_state.gd"
CoreNetwork="*res://core/network_manager.gd"
CoreSave="*res://core/save_manager.gd"
CoreSession="*res://core/session_manager.gd"
CoreSettings="*res://core/settings_manager.gd"
CoreWeather="*res://core/weather_manager.gd"
CoreSessionUI="*res://ui/session_ui.tscn"
CorePauseMenu="*res://ui/pause_menu.tscn"
CoreVictoryScreen="*res://ui/victory_screen.tscn"
CoreWeatherFx="*res://ui/weather_fx.gd"
CoreWeatherUI="*res://ui/weather_hud.gd"
DebugBridge="*res://gameplay/debug/debug_bridge.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

