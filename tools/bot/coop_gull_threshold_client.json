{
	"scene": "res://world/lobby_base.tscn",
	"dump_every": 5,
	"screenshot_every": 5,
	"steps": [
		{"t": 1.5, "join": "127.0.0.1", "port": 7796, "timeout": 20},
		{"wait_until": "players>=2", "timeout": 45},
		{"sleep": 0.5},
		{"t": 0, "loop": [
			{"goto_spot": "nearest", "timeout": 5, "if": "nearest_spot<9000"},
			{"dig_spot": true, "mode": "fast", "timeout": 15, "if": "nearest_spot<=1.8"},
			{"pickup": true, "radius": 6, "timeout": 6, "if": ["free_slots>=1", "pickup_dist<=6"]},
			{"sleep": 0.5}
		], "until": "time>=45", "timeout": 50},
		{"t": 0, "dump": "c1"},
		{"sleep": 40.0},
		{"t": 0, "dump": "c2_final"},
		{"t": 0, "quit": true}
	]
}
