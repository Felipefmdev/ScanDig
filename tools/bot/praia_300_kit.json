{
	"scene": "res://world/map_praia.tscn",
	"dump_every": 60,
	"screenshot_every": 120,
	"steps": [
		{"t": 0.2, "set_state": {"upgrade_levels": {"detector": 2, "shovel": 1, "pinpointer": 1, "backpack": 2}}},
		{"t": 1.0, "screenshot": "00_spawn"},
		{"t": 1.0, "dump": "00_spawn"},
		{"t": 1.2, "pickup": true, "radius": 8, "timeout": 10},
		{"t": 1.2, "screenshot": "01_detector"},
		{"t": 1.5, "loop": [
			{"goto_sell": true, "timeout": 60, "if": ["deliverable>=1", "free_slots<=0"]},
			{"sell": true, "timeout": 5, "if": ["deliverable>=1", "sell_dist<=2"]},
			{"explore": 10, "bounds": [-23, -23, 23, 23], "stop_near_spot": 13, "timeout": 15, "if": ["free_slots>=1", "nearest_spot>13"]},
			{"goto_spot": "nearest", "walk": true, "radius": 13, "timeout": 40, "if": ["free_slots>=1", "nearest_spot<=13"]},
			{"dig_spot": true, "mode": "smart", "timeout": 30, "if": ["free_slots>=1", "nearest_spot<=1.8"]},
			{"pickup": true, "radius": 6, "timeout": 10, "if": ["free_slots>=1", "pickup_dist<=6"]}
		], "until": "money>=300", "timeout": 1200},
		{"t": 0, "screenshot": "99_final"},
		{"t": 0, "dump": "99_final"},
		{"t": 0, "quit": true}
	]
}
