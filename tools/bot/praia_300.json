{
	"scene": "res://world/map_praia.tscn",
	"dump_every": 60,
	"screenshot_every": 120,
	"steps": [
		{"t": 1.0, "screenshot": "00_spawn"},
		{"t": 1.0, "dump": "00_spawn"},
		{"t": 1.5, "loop": [
			{"goto_sell": true, "timeout": 60, "if": ["deliverable>=1", "free_slots<=0"]},
			{"goto_sell": true, "timeout": 60, "if": ["deliverable>=1", "nearest_spot>30"]},
			{"sell": true, "timeout": 5, "if": ["deliverable>=1", "sell_dist<=2"]},
			{"wait_until": "nearest_spot<9000", "timeout": 30, "if": "nearest_spot>=9000"},
			{"goto_spot": "nearest", "walk": true, "timeout": 40, "if": "free_slots>=1"},
			{"dig_spot": true, "mode": "smart", "timeout": 30, "if": "free_slots>=1"},
			{"pickup": true, "radius": 6, "timeout": 10, "if": "free_slots>=1"}
		], "until": "money>=300", "timeout": 1200},
		{"t": 0, "screenshot": "99_final"},
		{"t": 0, "dump": "99_final"},
		{"t": 0, "quit": true}
	]
}
