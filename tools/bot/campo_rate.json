{
	"scene": "res://world/map_campo.tscn",
	"dump_every": 60,
	"screenshot_every": 120,
	"steps": [
		{"t": 1.0, "screenshot": "00_spawn"},
		{"t": 1.0, "dump": "00_spawn"},
		{"t": 1.2, "pickup": true, "radius": 8, "timeout": 10},
		{"t": 1.5, "loop": [
			{"fight": 10, "radius": 6, "if": "enemy_dist<=5"},
			{"goto_sell": true, "timeout": 60, "if": ["deliverable>=1", "free_slots<=0"]},
			{"sell": true, "timeout": 5, "if": ["deliverable>=1", "sell_dist<=2"]},
			{"explore": 10, "bounds": [-27, -27, 27, 27], "stop_near_spot": 8, "timeout": 15, "if": ["free_slots>=1", "nearest_spot>8"]},
			{"goto_spot": "nearest", "walk": true, "radius": 8, "timeout": 40, "if": ["free_slots>=1", "nearest_spot<=8"]},
			{"dig_spot": true, "mode": "smart", "timeout": 30, "if": ["free_slots>=1", "nearest_spot<=1.8"]},
			{"pickup": true, "radius": 6, "timeout": 10, "if": ["free_slots>=1", "pickup_dist<=6"]}
		], "until": "money>=1000", "timeout": 900},
		{"t": 0, "screenshot": "99_final"},
		{"t": 0, "dump": "99_final"},
		{"t": 0, "quit": true}
	]
}
