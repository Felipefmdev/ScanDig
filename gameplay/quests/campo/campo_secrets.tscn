line_offer = "Ai, ainda bem que você chegou! Os corvos levaram as três chaves do celeiro... Toque o sino perto do palheiro para chamar eles e pegue as chaves que eles soltarem!"
line_active = "Toque o sino para chamar os corvos. Cada um que você derrubar solta uma chave!"
line_ready = "As três chaves! Traga pra mim, querido!"
line_turn_in = "Obrigada! ... Está ouvindo isso? É o Corvo-Rei, o chefe deles, em cima da lavoura! Pega ele!"
line_event = "Ele só desce quando ataca: espere ele pousar e acerte com a pá!"
line_failed = "Ele fugiu... Fale comigo outra vez."
line_win = "Você mostrou quem manda! Tome o Sino de Bronze do meu avô: é para o museu."
line_done = "Obrigada! E o poço... dizem que quem joga uma moeda lá dentro ouve um segredo."
line_holding = "Essa chave na sua mão... você achou! Traga aqui, querido!"
line_map_hint = "Meu avô falava de um mapa antigo rasgado em pedaços. Tem um pedaço aqui no Campo: algo grande anda cavando túneis debaixo do círculo de pedras."

