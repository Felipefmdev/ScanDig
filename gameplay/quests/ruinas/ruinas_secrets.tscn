holding_item_id = "idolo_jade"
line_offer = "Olá! Sou a Inês. Estou tentando abrir a câmara selada na sala do trono, mas preciso de 3 tábuas com glifos espalhadas pelas ruínas para decifrar os selos. Você consegue achar as tábuas?"
line_active = "Procure as três tábuas com glifos: estão escondidas pelo pátio, entre a selva e junto à entrada da cripta."
line_ready = "Incrível, você reuniu as três tábuas! Consegui decifrar o encantamento! Mas prepare-se: os guardiões de pedra vão despertar para defender a sala do trono!"
line_turn_in = "O ritual começou! Vá até a sala do trono e derrote as quatro ondas de guardiões de pedra!"
line_event = "Aguente firme na sala do trono! Vença as quatro ondas de guardiões de pedra!"
line_failed = "Os guardiões foram fortes demais... Fale comigo quando quiser tentar novamente."
line_win = "Você conseguiu quebrar o selo! Tome o Ídolo de Jade sagrado da câmara como agradecimento. Dizem que colocar o ídolo no pedestal da cripta desperta algo ancestral..."
line_done = "Obrigada pela sua ajuda na escavação! Tome cuidado na cripta com esse ídolo..."
line_holding = "Esse artefato de jade na sua mão! É autêntico, traga aqui para eu ver!"
line_map_hint = "Este mapa é mais antigo do que as próprias Ruínas! E tem outro pedaço por aqui: bata nas paredes, uma delas soa oca."

