[node name="Vega" type="Node3D" parent="Ground"]
transform = Transform3D(0.921061, 0, 0.389418, 0, 1, 0, -0.389418, 0, 0.921061, -12.5, 0, 8.5)
script = ExtResource("3_npc")
interact_range = 3.2
focus_offset = Vector3(0, 1.2, 0)
npc_name = "Dra. Vega"
quest_id = "vega_sinal"
objective_flag = &"antenas_calibradas"
accept_flag = &"vega_missao"
event_path = NodePath("../../AntennaWaveEvent")
reward_item_id = "cristal_eco"
reward_drop_offset = Vector3(0, 1.2, -1.5)
holding_item_id = "cristal_eco"
line_offer = "Saudações, explorador! Sou a Dra. Vega, astrofísica chefe desta estação na cratera. Estou a captar um sinal pulsante misterioso vindo do fundo da fenda... mas preciso que calibres as 3 antenas de retransmissão espalhadas pela borda da cratera!"
line_active = "Precisamos das 3 antenas calibradas: uma a leste junto aos monólitos, outra a norte nos pilares de cristal e a terceira a oeste perto da fenda."
line_ready = "Excelente trabalho! As três antenas estão sincronizadas em fase! Vou iniciar a transmissão para decifrar a frequência profunda. Atenção aos sensores: as criaturas da cratera estão a convergir para cá!"
line_turn_in = "Iniciando a transmissão! Defende a antena da estação contra as hordas alienígenas!"
line_event = "A transmissão está a meio! Não deixes os rastejadores e flutuadores destruírem o transmissor!"
line_failed = "O sinal foi interrompido pelas criaturas alienígenas... Reagrupa-te e avisa-me quando estiveres pronto para nova tentativa."
line_win = "Sinal decifrado com sucesso! A fenda respondeu com este espécime ressonante... Toma este Cristal do Eco e a recompensa pelo teu esforço heroico!"
line_done = "O sinal da cratera foi mapeado. Tem cuidado com os cristais ressonantes... sinto que vibram em harmonia com algo muito antigo nas profundezas."
line_holding = "Os meus sensores estão a disparar com esse cristal na tua mão! Traz cá!"
line_map_hint = "O sinal vinha de um pedaço de mapa! A última peça está com o que dorme no altar da Cratera. Com o mapa inteiro, a ilha que ele mostra deixa de ser lenda."

