line_offer = "Ahoy! Sou o Pescador Zé. Perdi meu anzol de ouro no baixio, à beira-mar em frente à doca... Você encontra pra mim? Seu detector apita!"
line_active = "O anzol caiu no baixio, ali à beira da água em frente à doca. Cave onde o detector apitar!"
line_ready = "Esse brilho... é o meu anzol! Traga aqui no barco!"
line_turn_in = "Meu anzol de ouro! Obrigado! ... Ai, a areia está se mexendo... é a MARÉ VERMELHA! Defenda meu barco!"
line_event = "Não deixe os caranguejos chegarem ao barco!"
line_failed = "Destruíram meu barco... Fale comigo quando estiver pronto e tentamos outra vez!"
line_win = "Você conseguiu! Tome minha Concha Dourada: leve ao museu!"
line_done = "Obrigado, amigo! E se ouvir as conchas cantando... cuidado com o naufrágio."
line_holding = "Olha esse brilho na sua mão! É isso mesmo, traga aqui no barco!"
line_map_hint = "Aquele papel velho do barco é um pedaço de um mapa antigo! Dizem que há mais pedaços enterrados por aí... junte todos e veja para onde apontam."

