[node name="Bjorn" type="Node3D" parent="Ground"]
transform = Transform3D(0.362358, 0, -0.932039, 0, 1, 0, 0.932039, 0, 0.362358, -13.5, 0, 7.5)
script = ExtResource("3_npc")
interact_range = 3.0
focus_offset = Vector3(0, 1.1, 0)
npc_name = "Velho Björn"
quest_id = "bjorn_expedicao"
objective_flag = &"expedicao_encontrada"
accept_flag = &"bjorn_missao"
event_path = NodePath("../../WalrusElderTrigger")
reward_item_id = "bussola_antiga"
reward_drop_offset = Vector3(0, 1.2, -1.4)
holding_item_id = "bussola_antiga"
line_offer = "Brrr... Que vento cortante! Sou o velho Björn, o último sobrevivente da grande expedição. Perdi meu diário de bordo e o trenó de carga em algum lugar do gelo. Encontre os dois para eu saber onde meus companheiros foram parar!"
line_active = "Procure meu diário de navegação e o trenó de suprimentos: um deve estar soterrado na neve e o outro preso perto da passagem do arco."
line_ready = "Pelos deuses do norte, você recuperou as anotações e o trenó! Mas olhe para o lago... A Morsa Anciã acordou furiosa com o barulho no gelo!"
line_turn_in = "Defenda o lago gelado da Morsa Anciã! Não deixe ela quebrar a geleira toda!"
line_event = "Aguente firme contra a Morsa Anciã no lago gelado!"
line_failed = "A morsa foi implacável no gelo fino... Descanse perto da lareira e fale comigo quando estiver pronto."
line_win = "Você derrotou a besta dos mares gelados! Como prometido, tome esta recompensa e minha fiel Bússola Antiga da Expedição!"
line_done = "Obrigado por ajudar um velho explorador. Esquente-se na lareira sempre que precisar curar as feridas."
line_holding = "Pelos deuses do norte, você está com a relíquia da expedição na mão! Traga aqui!"
line_map_hint = "A expedição seguia um mapa rasgado. Um pedaço ficou bem fundo no gelo: cave fundo na Geleira, que um achado raro pode trazer mais do que parece."

